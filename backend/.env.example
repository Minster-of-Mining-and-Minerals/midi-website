# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=midi_portal
DB_DIALECT=postgres

# ==========================================
# Server & Security Configuration
# ==========================================
PORT=4000
SOCKET_PORT=5000
JWT_SECRET=generate-a-strong-secret-key-here
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# ==========================================
# Application Settings
# ==========================================
APP_TIMEZONE=Africa/Addis_Ababa
APP_NAME=MIDI

# ==========================================
# Mailer / SMTP (Password resets & contact notifications)
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password
