# =================================================================
# Local Docker Compose & Environment Overrides
# Mineral Industry Development Institute (MIDI) Portal
# =================================================================

# Ports
FRONTEND_PORT=3005
BACKEND_PORT=4005
SOCKET_PORT=5005
NGINX_PORT=8085

# Secrets
AUTH_SECRET=generate-a-strong-secret-key-here
JWT_SECRET=generate-a-strong-secret-key-here

# Database
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=midi_portal

# App Settings
APP_TIMEZONE=Africa/Addis_Ababa
FRONTEND_URL=http://localhost:3005
NEXT_PUBLIC_BASE_URL=http://localhost:4005/api
NEXT_PUBLIC_BASE=http://localhost:4005
