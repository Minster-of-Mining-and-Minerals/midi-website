# =================================================================
# Mineral Industry Development Institute (MIDI) Portal
# Production Environment Variables for Target Server 10.100.14.6
# =================================================================
# INSTRUCTIONS:
# 1. On server 10.100.14.6, copy this file to .env.production:
#      cp .env.production.example .env.production
# 2. Fill in production secrets (AUTH_SECRET, JWT_SECRET, DB_PASSWORD).
# 3. Deploy services:
#      docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# =================================================================

# Server Network Configuration
SERVER_IP=10.100.14.6

# Host Ports (Preserve assigned ports to avoid conflicts)
FRONTEND_PORT=3005
BACKEND_PORT=4005
SOCKET_PORT=5005
NGINX_PORT=8085

# Browser Access URLs (Client-facing endpoints)
NEXT_PUBLIC_BASE_URL=http://10.100.14.6:4005/api
NEXT_PUBLIC_BASE=http://10.100.14.6:4005
NEXT_PUBLIC_FILE_URL=http://10.100.14.6:4005
NEXT_PUBLIC_APP_URL=http://10.100.14.6:3005
NEXT_PUBLIC_SOCKET_URL=http://10.100.14.6:5005
NEXT_PUBLIC_TIMEZONE=Africa/Addis_Ababa

# Internal Container Communication
INTERNAL_API_URL=http://backend:4000/api

# NextAuth Authentication Secrets (Must be at least 32 random characters)
AUTH_SECRET=replace_with_strong_random_secret_minimum_32_characters
NEXTAUTH_SECRET=replace_with_strong_random_secret_minimum_32_characters
AUTH_URL=http://10.100.14.6:3005/api/auth

# Backend JWT Configuration
JWT_SECRET=replace_with_strong_random_secret_minimum_32_characters
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
FRONTEND_URL=http://10.100.14.6:3005
CORS_ALLOWED_ORIGINS=http://10.100.14.6:3005,http://10.100.14.6:8085

# Database Configuration (PostgreSQL 16)
DB_USER=postgres
DB_PASSWORD=replace_with_strong_secure_db_password
DB_NAME=midi_portal

# Mailer / SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
